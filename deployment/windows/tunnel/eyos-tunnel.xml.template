<service>
  <id>eyos-tunnel-service</id>
  <name>eY OS Cloudflare Tunnel Service</name>
  <description>Outbound Cloudflare Tunnel connector for remote access to the loopback eY OS Home Service.</description>
  <executable>%BASE%\cloudflared.exe</executable>
  <arguments>tunnel --no-autoupdate run --token-file "C:\ProgramData\eY-OS\tunnel\config\tunnel-token"</arguments>
  <workingdirectory>C:\ProgramData\eY-OS\tunnel</workingdirectory>
  <serviceaccount>
    <domain>NT AUTHORITY</domain>
    <user>LocalService</user>
    <allowservicelogon>true</allowservicelogon>
  </serviceaccount>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <stoptimeout>60sec</stoptimeout>
  <onfailure action="restart" delay="15 sec" />
  <onfailure action="restart" delay="60 sec" />
  <onfailure action="none" />
  <resetfailure>1 hour</resetfailure>
  <logpath>C:\ProgramData\eY-OS\tunnel\logs</logpath>
  <log mode="roll-by-size-time">
    <sizeThreshold>10485760</sizeThreshold>
    <pattern>yyyyMMdd</pattern>
    <autoRollAtTime>00:00:00</autoRollAtTime>
    <zipOlderThanNumDays>7</zipOlderThanNumDays>
    <zipDateFormat>yyyyMMdd</zipDateFormat>
  </log>
</service>
