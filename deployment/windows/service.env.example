# Store the real file under C:\ProgramData\eY-OS\config and restrict its ACL
# to Administrators, SYSTEM, and LOCAL SERVICE.
EYOS_RUNTIME_DIR=C:\path\to\existing\eY-OS-runtime
EYOS_BIND_HOST=127.0.0.1
EYOS_TRUSTED_LAN_ACCESS=false
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
GOOGLE_MAPS_API_KEY=replace-me
NEST_CLIENT_ID=replace-me
NEST_CLIENT_SECRET=replace-me
NEST_REFRESH_TOKEN=replace-me
NEST_PROJECT_ID=replace-me
NEST_DEVICE_NAME=replace-me
NOTION_TOKEN=replace-me
NOTION_TASKS_DATA_SOURCE_ID=replace-me
FUEL_FINDER_CLIENT_ID=replace-me
FUEL_FINDER_CLIENT_SECRET=replace-me
FUEL_FINDER_STATION_BRAND=replace-me
FUEL_FINDER_POSTCODE_PREFIX=replace-me
