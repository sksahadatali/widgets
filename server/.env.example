PORT=3001

# Safe default: the service is reachable only from this PC.
EYOS_BIND_HOST=127.0.0.1
EYOS_TRUSTED_LAN_ACCESS=false

# Trusted private-LAN mode (unauthenticated) requires both values below.
# Never expose this port through a Public firewall profile, router forwarding,
# UPnP, or the internet.
# EYOS_BIND_HOST=0.0.0.0
# EYOS_TRUSTED_LAN_ACCESS=true

# Required for a production Household build. Must be an absolute path
# outside the Git checkout. Demo production does not use this directory.
EYOS_RUNTIME_DIR=C:\eY-OS\runtime

# Server-only route provider credential.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

NEST_CLIENT_ID=your_google_oauth_client_id
NEST_CLIENT_SECRET=your_google_oauth_client_secret
NEST_REFRESH_TOKEN=your_google_oauth_refresh_token
NEST_PROJECT_ID=your_device_access_project_id
NEST_DEVICE_NAME=enterprises/project-id/devices/device-id

FUEL_FINDER_CLIENT_ID=your_client_id_here
FUEL_FINDER_CLIENT_SECRET=your_client_secret_here
FUEL_FINDER_STATION_BRAND=your_station_brand_here
FUEL_FINDER_POSTCODE_PREFIX=your_postcode_prefix_here
